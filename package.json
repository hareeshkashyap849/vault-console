{
  "name": "vault-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A React/Next.js read-only console over an ERC-4626 vault: chain state, indexer history, and the events in between.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node tools/run-tests.mjs",
    "check": "node tools/run-tests.mjs && tsc --noEmit && node tools/check-single-source.mjs",
    "check:browser": "node tools/browser-assert.mjs",
    "fixtures": "node tools/capture-fixtures.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
